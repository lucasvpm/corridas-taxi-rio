# Exemplo de configuração da API (valores de DESENVOLVIMENTO; os defaults já apontam para o compose em localhost)
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=corridas
DB_PASSWORD=corridas_dev_only
DB_NAME=corridas
REDIS_URL=redis://localhost:6379
AMQP_URL=amqp://corridas:corridas_dev_only@localhost:5672
JWT_PUBLIC_KEY_PATH=../scripts/test-keys/public.pem
JWT_ISSUER=corridas-test-issuer
JWT_AUDIENCE=corridas-api
CACHE_TTL_SECONDS=3600
LOG_LEVEL=info
OTEL_SDK_DISABLED=true
