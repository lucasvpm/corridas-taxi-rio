# Copie para k8s/base/secrets.env (gitignored) e troque os valores.
# O deploy-kind.sh gera um secrets.env com senhas aleatórias se o arquivo não existir.
DB_PASSWORD=troque-me
MYSQL_ROOT_PASSWORD=troque-me
RABBITMQ_DEFAULT_USER=corridas
RABBITMQ_DEFAULT_PASS=troque-me
AMQP_URL=amqp://corridas:troque-me@rabbitmq:5672
